# toolfinity: Claude/Codex via HAL. see FORK.md.

# HAL's OpenAI-compatible vision endpoint and its bearer key (HAL_VISION_API_KEY on HAL)
TOOLFINITY_HAL_URL=https://hal.home.tfcollins.me/v1
TOOLFINITY_HAL_API_KEY=change-me

# tracer list must be explicit: hal-assist runs the local models below and asks
# Claude/Codex to pick, name and size the tools. list more than one tracer so
# the trace step (and its reference photo panel) shows before tracing.
TRACERS=hal-assist,isnet,birefnet-lite
TOOLFINITY_ASSIST_BASE_TRACERS=isnet,birefnet-lite
TOOLFINITY_ASSIST_MODEL=claude-sonnet-5

# name tools traced by the plain local tracers too (one HAL call per tool)
TOOL_LABEL_PROVIDER=hal
TOOLFINITY_NAME_MODEL=claude-haiku-4-5-20251001
# codex-default uses the Codex account's default model; ChatGPT accounts
# reject explicit ids such as gpt-5.5
# TOOLFINITY_ASSIST_MODEL=codex-default

# per-call budget; HAL calls take a few seconds to tens of seconds
TOOLFINITY_HAL_TIMEOUT_SECONDS=180

# reference photos and depth estimation
TOOLFINITY_MAX_REFERENCE_PHOTOS=6
TOOLFINITY_DEPTH_CLEARANCE_MM=1.0
TOOLFINITY_DEPTH_MIN_CONFIDENCE=0.6
